generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id         Int        @id @default(autoincrement())
  name       String
  email      String?    @unique
  image      String?
  apelido    String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?
  postagens  Postagem[]
  Tarefa     Tarefa[]
  favorito   Favorito[]

  @@map("usuarios")
}

model Postagem {
  id         Int       @id @default(autoincrement())
  title      String
  content    String
  usuario_id Int
  usuario    Usuario   @relation(fields: [usuario_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("postagens")
}

model Tarefa {
  id         Int       @id @default(autoincrement())
  conteudo   String
  concluido  Boolean   @default(false)
  usuario_id Int
  usuario    Usuario   @relation(fields: [usuario_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("tarefas")
}

model Filmes {
  id         Int        @id @default(autoincrement())
  titulo     String
  descricao  String
  imagemUrl  String
  favoritos  Favorito[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?

  @@map("filmes")
}

model Favorito {
  id         Int     @id @default(autoincrement())
  usuario    Usuario @relation(fields: [usuario_id], references: [id])
  usuario_id Int
  filme      Filmes  @relation(fields: [filme_id], references: [id])
  filme_id   Int

  created_at DateTime @default(now())

  @@unique([usuario_id, filme_id])
  @@map("favoritos")
}
